def flag():
    size = 8

    l = [''] * (size * 3)

    for y in range(size * 3):
        for x in range(size * 5):
            if (y - (size * 3) // 2)**2 + (x - (size * 5) * 9 // 20)**2 <= ((size * 5) // 5)**2:
                l[y]+=(f'{Background_Red}{'  '}{Reset}')
            else:
                l[y]+=(f'{Background_Green}{'  '}{Reset}')

    for y in l:
        print(y)

